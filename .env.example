# CAWASMA backend configuration template.
# Copy to `.env` and adjust. NEVER commit the real `.env`.

# --- Environment ---
ENVIRONMENT=development
DEBUG=true

# --- Datastores ---
# Inside docker-compose, hosts are the service names (db, redis).
DATABASE_URL=postgresql+asyncpg://cawasma:cawasma@db:5432/cawasma
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Frontend / CORS (comma-separated; never "*") ---
FRONTEND_ORIGIN=http://localhost:5173

# --- Scanner safety limits ---
REQUEST_TIMEOUT=15.0
MAX_RESPONSE_SIZE=5000000
MAX_ENDPOINTS=200
MAX_CRAWL_DEPTH=2
MAX_REDIRECTS=5
MAX_CONCURRENT_REQUESTS=10
RATE_LIMIT_PROBE_COUNT=15
USER_AGENT=CAWASMA-Scanner/1.0 (+defensive-security-research)

# --- Optional LLM (core scanner works without these) ---
# Used by the NLP classifier to expand URL abbreviations (e.g. usr -> user,
# iam -> identity access management). When LLM_ENABLED=false, or no key is set,
# the built-in abbreviation table is used instead and scanning still works.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_ENABLED=false
LLM_PROVIDER=anthropic
LLM_MODEL=

# Run scans in-process instead of via Celery (no Redis/worker needed).
# Handy for simple deployments and demos. Default: false (uses Celery).
RUN_SCANS_INLINE=false
